# DeliveryHub — exemplo de configuração
# Copie para .env e ajuste os valores

# Banco SQLite do DeliveryHub
DATABASE_URL="file:./prisma/deliveryhub.db"

# Segredo de sessão (obrigatório em produção)
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-em-producao"

# URL pública do DeliveryHub (seu domínio HTTPS)
# Em local: http://localhost:3000
# Em produção: https://app.seudominio.com.br
AUTH_URL="http://localhost:3000"

# Porta do container (Docker)
PORT=3000

# Nunca deixe true em produção após o primeiro acesso
SEED_ON_BOOT=false
